{
  "_comment": "MDR-SIM Phase 7 Frozen Scalability Configuration v1.0.0. Population size and gateway density scaling.",
  "configId": "scalability-v1.0.0",
  "configVersion": "1.0.0",
  "scenarioFamily": "scalability",
  "datasetVersion": "2.0",
  "scenarioVersion": "1.0",
  "seed": 104729,
  "durationSeconds": 1800,
  "populationSize": 20,
  "gatewayCount": 4,
  "timeStepSeconds": 1,
  "rooms": [],
  "contactDefinition": {
    "distanceThresholdMeters": 2.0,
    "minimumDurationSeconds": 30,
    "roomConstraint": "same-room"
  },
  "ble": {
    "advertising": {
      "intervalMs": 500,
      "jitterMinMs": 0,
      "jitterMaxMs": 10,
      "advertisementType": "legacy"
    },
    "rssi": {
      "referenceDistanceMeters": 1.0,
      "referenceRSSIDbm": -50,
      "pathLossExponent": 2.5,
      "noiseSigmaDb": 6.0
    },
    "reception": {
      "packetLossProbability": 0.05,
      "receiverSensitivityDbm": -95
    }
  },
  "edge": {
    "validation": {
      "minRssiDbm": -110,
      "maxRssiDbm": 0,
      "maxTimestampSkewMs": 5000
    },
    "deduplication": {
      "enabled": true,
      "timeWindowMs": 20
    },
    "rssiFilter": {
      "method": "median",
      "windowSize": 5
    },
    "proximity": {
      "model": "log-distance",
      "thresholdDistanceMeters": 2.0
    },
    "candidateGeneration": {
      "temporalWindowMs": 1000
    },
    "sessionization": {
      "minimumObservationCount": 3,
      "minimumDurationSeconds": 30,
      "maxGapSeconds": 5
    }
  },
  "_sweepDimensions": {
    "populationSizeSweep": [20, 50, 80, 120],
    "gatewayCountSweep": [4, 8, 12, 16],
    "note": "Each population size uses 2x gatewayCount relative to populationSize/10."
  }
}
